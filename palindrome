#include <iostream>
using namespace std;

bool is_palindrome(int num) {
    int original = num;
    int reverse = 0;

    while (num > 0) {
        int digit = num % 10;
        reverse = reverse * 10 + digit;
        num = num / 10;
    }

    if (original == reverse)
        return true;
    else
        return false;
}

int main() {
    int number;

    cout << "Enter a number: ";
    cin >> number;

    if (is_palindrome(number))
        cout << "Palindrome number";
    else
        cout << "Not a palindrome";

    return 0;
}
